{
  "name": "pi-sota-harness",
  "version": "0.1.0",
  "description": "Self-improving Solo-SOTA Pi coding agent harness with Quint formal verification gates",
  "type": "module",
  "private": true,
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=23.6"
  },
  "pi": {
    "extensions": [
      "./extensions/solo-sota-harness.ts",
      "./extensions/plan-quint-qa-modes.ts",
      "./extensions/self-ratchet.ts"
    ],
    "skills": ["./skills"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"overlays/**/*.test.mjs\"",
    "lint:architecture": "node ./overlays/ts-node/lint-architecture.mjs src extensions",
    "quint:check": "bash ./spec/scripts/check.sh",
    "quint:prove": "bash ./spec/scripts/prove.sh",
    "init": "bash ./init.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@informalsystems/quint": "0.33.1",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
